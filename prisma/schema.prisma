datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  DIVISION_HEAD
  FIELD_OFFICER
}

enum DivisionType {
  LOGISTICS
  SHELTER
  DATA_REGISTRATION
}

enum CampStatus {
  ACTIVE
  CLOSED
}

enum ItemStatus {
  SUFFICIENT
  LOW
  CRITICAL
  SPOILED_OR_DAMAGED
}

enum FacilityStatus {
  GOOD
  DAMAGED
  REPAIRING
}

enum DistributionStatus {
  PENDING
  APPROVED
  RESERVED
  REJECTED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  DAMAGE
  LOSS
  RESTORE
  DISPOSE
  RESERVATION
  RESERVATION_RELEASE
  DISTRIBUTION_OUT
  DISTRIBUTION_IN
}

enum UnitDimension {
  COUNT
  MASS
  VOLUME
}

enum UnitConversionStatus {
  CONFIGURED
  NEEDS_REVIEW
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role     Role
  division DivisionType?

  campId                    String?
  camp                      Camp?               @relation("CampStaff", fields: [campId], references: [id], onDelete: SetNull)
  managedCamp               Camp?               @relation("CampManager")
  divisionHeadAssignments   CampDivisionHead[]  @relation("DivisionHeadUser")
  sessions                  Session[]
  logisticsRequestsCreated  LogisticsRequest[]  @relation("RequestCreatedBy")
  logisticsRequestsReviewed LogisticsRequest[]  @relation("RequestReviewedBy")
  distributionsCreated      Distribution[]      @relation("DistributionCreatedBy")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreator")
  auditLogs                 AuditLog[]          @relation("AuditLogUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId])
  @@index([role, division])
}

model Camp {
  id      String @id @default(cuid())
  name    String
  address String

  latitude  Float
  longitude Float

  maxCapacity      Int
  currentOccupants Int @default(0)

  status CampStatus @default(ACTIVE)

  managerId          String?             @unique
  manager            User?               @relation("CampManager", fields: [managerId], references: [id], onDelete: SetNull)
  staff              User[]              @relation("CampStaff")
  divisionHeads      CampDivisionHead[]
  logistics          LogisticsItem[]
  facilities         FacilityReport[]
  evacuees           EvacueeRecord[]
  requestsFrom       LogisticsRequest[]  @relation("RequestSourceCamp")
  requestsTo         LogisticsRequest[]  @relation("RequestDestinationCamp")
  distributionsFrom  Distribution[]      @relation("DistributionSourceCamp")
  distributionsTo    Distribution[]      @relation("DistributionDestinationCamp")
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model CampDivisionHead {
  id        String       @id @default(cuid())
  campId    String
  division  DivisionType
  userId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)
  user User @relation("DivisionHeadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campId, division])
  @@unique([userId, campId])
  @@index([userId])
}

model LogisticsItem {
  id String @id @default(cuid())

  campId String
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)

  itemName         String
  quantity         Int
  reservedQuantity Int    @default(0)
  damagedQuantity  Int    @default(0)
  minimumQuantity  Int    @default(0)
  unit             String
  baseUnit         String             @default("pcs")
  unitDimension     UnitDimension     @default(COUNT)
  conversionFactor  Int                @default(1)
  conversionStatus  UnitConversionStatus @default(NEEDS_REVIEW)
  conversionNote    String?
  quantityBase      Int                @default(0)
  reservedQuantityBase Int             @default(0)
  damagedQuantityBase  Int             @default(0)
  minimumQuantityBase  Int             @default(0)

  status              ItemStatus     @default(SUFFICIENT)
  notes               String?
  sourceDistributions Distribution[] @relation("DistributionSourceItem")

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  movements InventoryMovement[]

  @@index([campId])
  @@index([campId, status])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  logisticsItemId String
  campId          String
  type            InventoryMovementType
  quantity        Int
  baseQuantity    Int?
  baseUnit        String?
  unitDimension   UnitDimension?
  conversionFactor Int?
  reason          String?
  createdById     String?
  distributionId  String?
  createdAt       DateTime              @default(now())

  logisticsItem LogisticsItem @relation(fields: [logisticsItemId], references: [id], onDelete: Restrict)
  camp          Camp          @relation(fields: [campId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  distribution  Distribution? @relation(fields: [distributionId], references: [id], onDelete: SetNull)

  @@index([logisticsItemId, createdAt])
  @@index([campId, createdAt])
  @@index([type, createdAt])
  @@index([distributionId])
}

model LogisticsRequest {
  id                String  @id @default(cuid())
  sourceCampId      String
  destinationCampId String
  createdById       String
  reviewedById      String?

  itemName        String
  quantity        Int
  unit            String
  requestedQuantity Int?
  requestedUnit     String?
  baseQuantity      Int?
  baseUnit          String?
  unitDimension     UnitDimension?
  conversionFactor  Int?
  conversionStatus  UnitConversionStatus?
  notes           String?
  rejectionReason String?
  status          DistributionStatus @default(PENDING)

  sourceCamp      Camp          @relation("RequestSourceCamp", fields: [sourceCampId], references: [id], onDelete: Cascade)
  destinationCamp Camp          @relation("RequestDestinationCamp", fields: [destinationCampId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy      User?         @relation("RequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  distribution    Distribution?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceCampId])
  @@index([destinationCampId])
  @@index([status])
  @@index([createdById])
}

model Distribution {
  id                String  @id @default(cuid())
  requestId         String  @unique
  sourceCampId      String
  destinationCampId String
  sourceItemId      String?
  createdById       String

  itemName          String
  quantity          Int
  unit              String
  requestedQuantity  Int?
  requestedUnit      String?
  baseQuantity       Int?
  baseUnit           String?
  unitDimension      UnitDimension?
  conversionFactor   Int?
  conversionStatus   UnitConversionStatus?
  notes             String?
  status     DistributionStatus @default(APPROVED)
  shippedAt  DateTime?
  receivedAt DateTime?
  receiptProofData     String? @db.Text
  receiptProofName     String?
  receiptProofMimeType String?

  inventoryMovements InventoryMovement[]

  request         LogisticsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sourceItem      LogisticsItem?   @relation("DistributionSourceItem", fields: [sourceItemId], references: [id], onDelete: SetNull)
  sourceCamp      Camp             @relation("DistributionSourceCamp", fields: [sourceCampId], references: [id], onDelete: Cascade)
  destinationCamp Camp             @relation("DistributionDestinationCamp", fields: [destinationCampId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("DistributionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceCampId])
  @@index([destinationCampId])
  @@index([status])
  @@index([createdById])
}

model FacilityReport {
  id String @id @default(cuid())

  campId String
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)

  facilityName String
  status       FacilityStatus @default(GOOD)
  description  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId])
  @@index([campId, status])
}

model EvacueeRecord {
  id String @id @default(cuid())

  campId String
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)

  name            String
  totalFamily     Int     @default(1)
  hasSpecialNeeds Boolean @default(false)

  notes String?

  arrivedAt  DateTime  @default(now())
  departedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId])
  @@index([campId, departedAt])
  @@index([campId, hasSpecialNeeds])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, createdAt])
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
